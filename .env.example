# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# RushDB (Primary Cloud / Engine Database)
# Option A - RushDB Cloud: set RUSHDB_API_KEY from https://app.rushdb.com
RUSHDB_API_KEY=
# Option B - RushDB Local Engine (direct mode)
RUSHDB_MODE=direct
RUSHDB_ENGINE_URL=http://127.0.0.1:3000
RUSHDB_ENGINE_TOKEN=local-token

# Permanent File Storage (Supabase Storage)
# Uses new Supabase API key format (sb_publishable_... and sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Security & Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production

# Administrator Credentials (Used for admin dashboard authentication)
ADMIN_NAME=S4DSMITAOE Administrator
ADMIN_EMAIL=YOUR MAIL
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Public Chapter Contact & Payment Details
NEXT_PUBLIC_CHAPTER_EMAIL=YOUR MAIL
NEXT_PUBLIC_CHAPTER_PHONE=+91 020 3025 3500
NEXT_PUBLIC_UPI_ID=s4ds.@upi
